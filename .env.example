# ── Copy this file to .env.local in your project root ──
# Never commit .env.local to git

# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your site URL (change to production URL when deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side settings (copy to backend/.env or system env in production)
DATABASE_URL=postgresql://mkchain:mkchain123@localhost:5432/mkchain
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
FRONTEND_URL=http://localhost:3000

# Optional third-party API keys
ETHERSCAN_API_KEY=
BLOCKCYPHER_TOKEN=
GROQ_API_KEY=
